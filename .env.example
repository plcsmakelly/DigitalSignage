APP_NAME=DigitalSignage
APP_ENV=local
APP_KEY=base64:uZ3lxM+5l7C+1DppW/RHlOQXIY0xYqzDhLsyKs3n8fQ=
# Set this to True to show error messages to end users (debug mode)
APP_DEBUG=False
# Update the below URL to the root path of your hosted server
APP_URL=https://signage.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Update the below database information if you change the docker compose file
DB_CONNECTION=mysql
DB_HOST=ds_database
DB_PORT=3306
DB_DATABASE=ds
DB_USERNAME=root
DB_PASSWORD=databasepassword

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Update the lifetime below if you want users to stay logged in longer
SESSION_LIFETIME=120

# Update the fields below for your SSO provider
# Base URL to your SSO IDP
SAML2_IDP_IDP_HOST=https://idp.yourdomain.com
# PEM data of your SP certificate (without BEGIN CERTIFICATE, END CERTIFICATE, etc.)
SAML2_IDP_SP_x509=""
# PEM data of your unencrypted SP certificate private key (without BEGIN PRIVATE KEY, END PRIVATE KEY, etc.)
SAML2_IDP_SP_PRIVATEKEY=""
# Entity ID for your SP (usually the base domain of your server)
SAML2_IDP_SP_ENTITYID=https://signage.yourdomain.com
# Entity ID of your Identity Provider IDP
SAML2_IDP_IDP_ENTITYID=https://idp.yourdomain.com
# ACS URL for your Identity Provider IDP (usually found in the metadata)
SAML2_IDP_IDP_SSO_URL=https://idp.yourdomain.com/saml/acs
# SLO URL for your Identity Provider IDP (usually found in the metadata)
SAML2_IDP_IDP_SL_URL=https://idp.yourdomain.com/saml/sls
# PEM data of your IDP certificate (usually found in the metadata)
SAML2_IDP_IDP_x509=""

# Name of this app, shown on Google consent screens
GOOGLE_APP_NAME="Digital Signage Manager"
# Domain name of your Google instance if you are using an internal OAuth app
GOOGLE_HOSTED_DOMAIN=yourdomain.com

# Allow users to include weather slides (unfinished feature)
DS_ENABLE_WEATHER=False
# API Key to use with NWS (according to NWS, this should be your email address)
DS_WEATHER_API_KEY=youremail@yourdomain.com
# Allow users to include text slides and emergency alerts (unfinished feature)
DS_ENABLE_ALERTGEN=False
# URL to the AlertGen API service, required if Enable AlertGen is True
DS_ALERTGEN_URL=http://alertgen:5000

# Organization name shown on the topbar
DS_ORG_NAME="Some School District"
# URL to the organization logo, shown on the topbar
DS_ORG_LOGO=""